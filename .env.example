# Environment variables for Video Analysis Tool

# API Base URL (change this after deploying to Cloud Run)
# For local development: http://localhost:8080
# For production: https://your-service-name-xyz.run.app
VITE_API_URL=http://localhost:8080

# Firebase configuration (if using Firebase Storage)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=watch-mail-trial.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=watch-mail-trial
VITE_FIREBASE_STORAGE_BUCKET=watch-mail-trial.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
