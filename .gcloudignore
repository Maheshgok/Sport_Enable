# .gcloudignore file
# Prevents unnecessary files from being uploaded to Cloud Build

# Version control
.git/
.gitignore
.gitattributes

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/
ENV/
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node/Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.eslintcache
dist/
build/
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# OS
Thumbs.db
.DS_Store
desktop.ini

# Local development
.env
.env.local
.env.*.local
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Large files
*.zip
*.tar
*.tar.gz
*.iso
*.dmg

# Cloud Build artifacts (these are created by Cloud Build)
# Don't exclude necessary files like:
# - api/
# - cloud-run/
# - src/
# - vite.config.js
# - package.json
# - requirements.txt

# But DO exclude:
.gcloud/
google-cloud-sdk/
.firebase/

# Documentation (not needed for build)
docs/
README.md
*.md

# Tests (optional - can exclude to speed up build)
# tests/
# *_test.py
