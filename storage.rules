rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Videos folder - allow uploads and reads
    match /videos/{videoId} {
      // Allow uploads up to 100MB for demo
      allow write: if request.resource.size < 100 * 1024 * 1024;
      allow read: if true;
    }
    
    // Temporary: allow all for demo
    // ⚠️ REMOVE FOR PRODUCTION
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
